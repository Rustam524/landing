# Supabase project settings — see SETUP.md for how to obtain these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to the browser.
# Used to create/block employee accounts from the director's admin screens.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build auth redirect links (password reset, invites).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
